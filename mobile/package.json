{
  "name": "omw-ios",
  "private": true,
  "description": "omw! as an iPhone app (Capacitor): the screens from ../web packed inside the app, data from the omw! server",
  "scripts": {
    "build": "node build-web.mjs",
    "assets": "npx --yes @capacitor/assets@3 generate --ios",
    "sync": "node build-web.mjs && cap sync ios",
    "open": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.3"
  }
}
